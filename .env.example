# Copy this to .env to use it. `npm run dev:client` (and `npm run dev`) read .env.

# The address of the backend the frontend connects to. Without it the backend on the machine the
# page came from (port 4101) is used in development.
#API_URL=https://my-service-name.onrender.com

# Whether the screen of a hotseat game has the button "Open a test phone", for trying a game with
# many players in one browser. Without it the button is there in development and not in a build.
#PLAYER_TESTING_MODE=true
